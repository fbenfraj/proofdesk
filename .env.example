# ProofDesk environment (AD-14: single shared operator credential — NO per-user accounts)
#
# Local dev/run: copy to `.env` (or `.env.local`) and set your own values.
#   - `next dev` loads these automatically.
#   - `npm start` (the standalone server) loads them too, because the start
#     script passes `--env-file-if-exists=.env[.local]`. (The standalone
#     server does NOT read .env files on its own — hence the explicit flags.)
#
# Production (AD-15): secrets come from the HOST SECRET STORE — export
# OPERATOR_USER / OPERATOR_PASSWORD into the process environment; do not ship a
# .env file. If both are unset in production the gate is CLOSED BY DEFAULT and
# rejects every request. Non-production falls back to operator/changeme only.
OPERATOR_USER=operator
OPERATOR_PASSWORD=changeme

# Persistence (AD-10): the single SQLite file. `/data` is gitignored. All DB
# access is confined to `src/repositories/`. EU-sovereign Postgres is a deferred
# v2 swap behind the same repository seam (AD-15) — do not introduce it now.
DB_PATH=./data/proofdesk.db
