# ProofDesk environment (AD-14: single shared operator credential — NO per-user accounts)
# Copy to `.env` (or `.env.local`) and set your own values before running.
#
# Basic-auth gate. If unset, the middleware falls back to operator/changeme in
# non-production ONLY, and REJECTS ALL requests in production until these are set.
OPERATOR_USER=operator
OPERATOR_PASSWORD=changeme
