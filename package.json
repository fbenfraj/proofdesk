{
  "name": "proofdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-static.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "tsx seed/index.ts",
    "seed": "npm run db:migrate && npm run seed:demo",
    "ci": "biome check && next typegen && tsc --noEmit && vitest run && npm run build",
    "review": "codex exec review --uncommitted",
    "review:base": "codex exec review --base main"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "csv-stringify": "^6.8.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
